# 1. Ignorar TUDO no nível principal do repositório
/*

# 2. Exceções (Pastas e Arquivos que SERÃO comitados)
!/.gitignore
!/docs/
!/scripts/
!/data/
!/RELATORIO_ETL.md
!/DICIONARIO_DE_DADOS.md
!/eda_bahia_2022.ipynb
!/Enunciado_Avaliação_A3_Análise_de_Dados_e_Big_Data.pdf
!/CHECKLIST_A3_Análise_de_Dados.html
